# 复制为 .env 并填写（.env 不入库）
# --- LLM 提炼（DeepSeek，OpenAI 兼容）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 小红书登录 cookie（M2 抓取用）---
# 浏览器登录 xiaohongshu.com 后，DevTools → Network → 任意请求复制完整 Cookie 头
XHS_COOKIE=

# --- 服务 ---
# 0.0.0.0 = 局域网可访问（手机连同一 Wi-Fi 打开 http://<电脑IP>:8080）
HOST=0.0.0.0
PORT=8080

# --- 访问密码（外网访问必开）---
# 设置后所有接口/图片都要登录；留空则不开启
# 生成方式: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
ACCESS_TOKEN=

# --- 高德地图 Web服务（餐厅按名搜索）---
# https://lbs.amap.com 注册 → 控制台 → 应用管理 → 创建应用 → 添加 Key（Web服务）
AMAP_KEY=

# --- 微信通知独立服务（可选：下单时推微信；服务部署见独立仓库 wechat-notify）---
WECHAT_NOTIFY_URL=
NOTIFY_TOKEN=
